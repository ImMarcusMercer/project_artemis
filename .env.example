# ============================================================
# Artemis v1.1 / ResQ Backend Environment
# Copy this file to .env and replace all placeholders.
# ============================================================

# Firebase is used for authentication and Firestore database.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PROJECT_NUMBER=your_firebase_project_number
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.appspot.com

# Web Firebase app
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=1:your_project_number:web:your_web_app_id
FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Android Firebase app
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=1:your_project_number:android:your_android_app_id

# iOS Firebase app
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=1:your_project_number:ios:your_ios_app_id
FIREBASE_IOS_BUNDLE_ID=com.example.artemis

# Supabase is used only for image/file management.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_STORAGE_BUCKET=artemis-files

# Development convenience.
# Set true while presenting the prototype before Firebase users are approved.
ALLOW_PENDING_DEMO_LOGIN=true
